# Optional: enables Gemini browser planning and vision features. Keep your real key private.
GEMINI_API_KEY=
# Voice: edge = natural neural voice (needs internet), auto = Windows voice. Default: edge if edge-tts is installed.
VAANI_TTS=edge
# Your local chat model (Ollama). Also used as the offline command brain when no Gemini key is set.
VAANI_MODEL=qwen2.5:3b-instruct
# Speech recognition accuracy: small.en is clearer than base.en. On a strong PC try distil-large-v3.
VAANI_STT_MODEL=small.en
# Seconds of quiet that end a sentence (an unfinished sentence waits for the rest automatically).
VAANI_END_SILENCE=0.9

# ---- smarter model for seeing the screen and planning (optional, pick one) ----
# ANTHROPIC_API_KEY=...        # Claude (needs: pip install anthropic). Models: VAANI_SMART_MODEL / VAANI_FAST_MODEL
# GEMINI_API_KEY=...           # Gemini. Models: GEMINI_SMART_MODEL / GEMINI_MODEL
# VAANI_LLM=anthropic          # force a provider (anthropic | gemini | ollama)
# VAANI_OLLAMA_VISION=qwen2.5vl:7b   # lets a LOCAL model look at screenshots (otherwise qwen reads the controls as text)

# ---- behaviour ----
# VAANI_STOP_HOTKEY=ctrl+alt+x   # global key that stops speech and cancels the running task
# VAANI_BARGE_IN=1               # saying "stop" while it talks interrupts it (0 = off)
# VAANI_AUTO_AGENT=1             # if a quick command fails, retry by looking at the real screen (0 = off)
# VAANI_CONFIRM_LOGPROB=-1.4     # ask "did you say...?" when speech recognition is this unsure
# VAANI_TTS=kokoro               # offline neural voice (pip install kokoro soundfile)
# VAANI_STT_BACKEND=parakeet     # optional: NVIDIA Parakeet via sherpa-onnx (English/European only)
# VAANI_PARAKEET_DIR=C:\models\sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8

# ---- wake word ----
# VAANI_WAKE_WORDS=jarvis,vaani   # names that wake it; the first is what VAANI says ("Hey Jarvis"). Try a short, distinctive name.
# VAANI_WAKE_EXTRA=bunny          # extra spellings the recogniser produces for your name (only counted after "hey")